{
  "manifest_version": 3,
  "name": "Gather",
  "description": "Keep what matters. Find it later. Save highlights and notes from any webpage.",
  "version": "0.1.0",
  "minimum_chrome_version": "105",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Gather" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "identity", "alarms"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
