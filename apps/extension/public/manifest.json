{
  "manifest_version": 3,
  "name": "Gather",
  "description": "Keep what matters. Find it later. Highlight any webpage, add notes and categories, and find everything in a side panel.",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Gather"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "identity",
    "alarms",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://gatherme.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Open the Gather panel"
    }
  }
}
